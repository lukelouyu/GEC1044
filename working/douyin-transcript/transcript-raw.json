{
  "duration": 51.2853125,
  "language": "zh",
  "segments": [
    {
      "start": 1.46,
      "end": 2.9,
      "text": "服属湿 伤脾胃"
    },
    {
      "start": 2.9,
      "end": 5.82,
      "text": "大便膝 睡不好 孩子挑食"
    },
    {
      "start": 5.82,
      "end": 9.12,
      "text": "这款平和养胃粥"
    },
    {
      "start": 9.12,
      "end": 10.74,
      "text": "全年龄段适配"
    },
    {
      "start": 10.74,
      "end": 12.94,
      "text": "老人小孩长期吃都没问题"
    },
    {
      "start": 12.94,
      "end": 15.56,
      "text": "准备蛋米60克"
    },
    {
      "start": 15.56,
      "end": 19.2,
      "text": "山药30克"
    },
    {
      "start": 19.2,
      "end": 22.48,
      "text": "莲子15克 红枣2克"
    },
    {
      "start": 22.48,
      "end": 25.72,
      "text": "莲子提前泡软备用"
    },
    {
      "start": 25.72,
      "end": 28.58,
      "text": "泡好后所有食材一同下锅"
    },
    {
      "start": 28.58,
      "end": 29.86,
      "text": "家族量清水"
    },
    {
      "start": 29.86,
      "end": 33.58,
      "text": "小火熬30分钟是浓稠"
    },
    {
      "start": 33.58,
      "end": 37.02,
      "text": "煮出来口感温和软糯"
    },
    {
      "start": 37.02,
      "end": 39.18,
      "text": "山药莲子性贫健脾"
    },
    {
      "start": 39.18,
      "end": 40.76,
      "text": "还能养兴盛"
    },
    {
      "start": 40.76,
      "end": 42.58,
      "text": "红枣自带清甜"
    },
    {
      "start": 42.58,
      "end": 44.18,
      "text": "不用额外驾头"
    },
    {
      "start": 44.18,
      "end": 47.54,
      "text": "每天一晚山药莲子粥"
    },
    {
      "start": 47.54,
      "end": 49.5,
      "text": "养好脾胃睡得香"
    }
  ]
}