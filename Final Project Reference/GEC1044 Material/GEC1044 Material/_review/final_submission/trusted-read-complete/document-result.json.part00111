  "endIndex": 31403,
                        "content": [
                          {
                            "startIndex": 31049,
                            "endIndex": 31403,
                            "paragraph": {
                              "elements": [
                                {
                                  "startIndex": 31049,
                                  "endIndex": 31154,
                                  "textRun": {
                                    "content": "Ginseng and Dang Shen are separate Qi-tonifying materials rather than one fixed formula. PolyU describes ",
                                    "textStyle": {
                                      "fontSize": {
                                        "magnitude": 11,
                                        "unit": "PT"
                                      }
                                    }
                                  }
                                },
                                {
                                  "startIndex": 31154,
                                  "endIndex": 31161,
                                  "textRun": {
                                    "content": "ginseng",
                                    "textStyle": {
                                      "underline": true,
                                      "foregroundColor": {
                                        "color": {
                                          "rgbColor": {
                                            "red": 0.06666667,
                                            "green": 0.33333334,
                                            "blue": 0.8
                                          }
                                        }
                                      },
                                      "fontSize": {
                                        "magnitude": 11,
                                        "unit": "PT"
                                      },
                                      "link": {
                                        "url": "https://herbaltcm.sn.polyu.edu.hk/herbal/ginseng"
                                      }
                                    }
                                  }
                                },
                                {
                                  "startIndex": 31161,
                                  "endIndex": 31219,
                                  "textRun": {
                                    "content": " as supporting original Qi and Spleen–Lung functions, and ",
                                    "textStyle": {
                                      "fontSize": {
                                        "magnitude": 11,
                                        "unit": "PT"
                                      }
                                    }
                                  }
                                },
                                {
                                  "startIndex": 31219,
                                  "endIndex": 31228,
                                  "textRun": {
                                    "content": "Dang Shen",
                                    "textStyle": {
                                      "underline": true,
                                      "foregroundColor": {
                                        "color": {
                                          "rgbColor": {
                                            "red": 0.06666667,
                                            "green": 0.33333334,
                                            "blue": 0.8
                                          }
                                        }
                                      },
                                      "fontSize": {
                                        "magnitude": 11,
                                        "unit": "PT"
                                      },
                                      "link": {
                                        "url": "https://herbaltcm.sn.polyu.edu.hk/herbal/tangshen"
                                      }
                                    }
                                  }
                                },
                                {
                                  "startIndex": 31228,
                                  "endIndex": 31403,
                                  "textRun": {
                                    "content": " as supporting Spleen and Lung Qi. Reference symptoms include poor appetite, shortness of breath and, for Dang Shen, loose stools; these provide context beyond fatigue alone.\n",
                                    "textStyle": {
                                      "fontSize": {
                                        "magnitude": 11,
                                        "unit": "PT"
                                      }
                                    }
                                  }
                                }
                              ],
