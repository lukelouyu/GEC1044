            },
            {
              "startIndex": 1149,
              "endIndex": 1387,
              "paragraph": {
                "elements": [
                  {
                    "startIndex": 1149,
                    "endIndex": 1386,
                    "textRun": {
                      "content": "We visited Tong Keow on 13 September 2026, photographed displays and interviewed one staff member. Transcripts, the presentation script, and photographs inform this report; we paraphrase unclear meanings where transcripts contain errors.",
                      "textStyle": {
                        "fontSize": {
                          "magnitude": 11,
                          "unit": "PT"
                        }
                      }
                    }
                  },
                  {
                    "startIndex": 1386,
                    "endIndex": 1387,
                    "textRun": {
                      "content": "\n