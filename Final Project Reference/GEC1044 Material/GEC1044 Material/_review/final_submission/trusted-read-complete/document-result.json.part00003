              "paragraph": {
                "elements": [
                  {
                    "startIndex": 586,
                    "endIndex": 601,
                    "textRun": {
                      "content": "1 Introduction\n",
                      "textStyle": {
                        "fontSize": {
                          "magnitude": 13,
                          "unit": "PT"
                        }
                      }
                    }
                  }
                ],
                "paragraphStyle": {
                  "namedStyleType": "HEADING_1",
                  "lineSpacing": 115,
                  "direction": "LEFT_TO_RIGHT",
                  "spaceAbove": {
                    "magnitude": 12,
                    "unit": "PT"
                  },
                  "spaceBelow": {
                    "magnitude": 7,
                    "unit": "PT"
                  },
                  "keepLinesTogether": true,
                  "keepWithNext": true
                }
              }
            },
            {
              "startIndex": 601,
              "endIndex": 883,
              "paragraph": {
                "elements": [
                  {
                    "startIndex": 601,
                    "endIndex": 882,
                    "textRun": {
                      "content": "At Tong Keow’s Hougang outlet, herbs and soup packs sit alongside everyday foods. Staff described purchases for nourishment, throat comfort, fatigue and daily routines. We argue that this retail setting keeps Traditional Chinese Medicine (TCM) visible and usable in household life.",
                      "textStyle": {
                        "fontSize": {
                          "magnitude": 11,
                          "unit": "PT"
                        }
                      }
                    }
                  },
                  {
                    "startIndex": 882,
                    "endIndex": 883,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {
                        "fontSize": {
                          "magnitude": 11,
                          "unit": "PT"
                        }
                      }
                    }
                  }
                ],
                "paragraphStyle": {
                  "namedStyleType": "NORMAL_TEXT",
                  "alignment": "START",
                  "lineSpacing": 115,
                  "direction": "LEFT_TO_RIGHT",
                  "spaceAbove": {
                    "unit": "PT"
                  },
                  "spaceBelow": {
                    "magnitude": 7,
                    "unit": "PT"
                  },
                  "avoidWidowAndOrphan": true
                }
              }
            },
            {
              "startIndex": 883,
              "endIndex": 1066,
              "paragraph": {
                "elements": [
                  {
                    "startIndex": 883,
                    "endIndex": 1066,
                    "textRun": {
                      "content": "The report examines food therapy, convenience and local adaptation through displays, staff accounts and public sources, without assessing clinical effectiveness or sales performance.\n",
                      "textStyle": {
                        "fontSize": {
                          "magnitude": 11,
                          "unit": "PT"
                        }
                      }
                    }
                  }
                ],
                "paragraphStyle": {
                  "namedStyleType": "NORMAL_TEXT",
                  "alignment": "START",
                  "lineSpacing": 115,
                  "direction": "LEFT_TO_RIGHT",
                  "spaceAbove": {
                    "unit": "PT"
                  },
                  "spaceBelow": {
                    "magnitude": 7,
                    "unit": "PT"
                  },
                  "avoidWidowAndOrphan": true
                }
              }
            },
            {
              "startIndex": 1066,
              "endIndex": 1114,
              "paragraph": {
                "elements": [
                  {
                    "startIndex": 1066,
                    "endIndex": 1114,
                    "textRun": {
                      "content": "2 Fieldwork and the neighbourhood medicine hall\n",
                      "textStyle": {
                        "fontSize": {
                          "magnitude": 13,
                          "unit": "PT"
                        }
                      }
                    }
                  }
                ],
                "paragraphStyle": {
                  "namedStyleType": "HEADING_1",
