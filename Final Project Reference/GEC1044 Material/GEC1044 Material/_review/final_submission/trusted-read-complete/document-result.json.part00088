                            "paragraph": {
                              "elements": [
                                {
                                  "startIndex": 25937,
                                  "endIndex": 26434,
                                  "textRun": {
                                    "content": "Traditional reference uses include boils and sores, painful throat swelling and oedema (fluid-related swelling) (PolyU, n.d.-c). In TCM, these applications relate to clearing heat and toxins, resolving blood stasis and promoting urination. Staff-described concerns about unfamiliarity and the need to combine herbs help explain the lower appeal of this raw material compared with prepared products. These are traditional reference uses; no treatment or prescription was observed during the visit.\n",
                                    "textStyle": {
                                      "fontSize": {
                                        "magnitude": 11,
                                        "unit": "PT"
                                      }
                                    }
                                  }
                                }
                              ],
