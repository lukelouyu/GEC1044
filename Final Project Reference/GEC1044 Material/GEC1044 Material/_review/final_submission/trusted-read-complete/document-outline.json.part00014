    {
      "paragraphId": "P00296",
      "path": "tabs.t.0.body.content[139].table.rows[1].cells[0].content[0]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 25894,
      "endIndex": 25896,
      "namedStyleType": "NORMAL_TEXT",
