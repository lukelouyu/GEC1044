                      {
                        "startIndex": 26455,
                        "endIndex": 26955,
                        "content": [
                          {
                            "startIndex": 26456,
                            "endIndex": 26955,
                            "paragraph": {
                              "elements": [
                                {
                                  "startIndex": 26456,
                                  "endIndex": 26654,
                                  "textRun": {
                                    "content": "Used as ingredients in a combination selected for a person's TCM pattern, rather than as one uniform product. Preparation may involve selecting compatible ingredients and quantities, then following ",
                                    "textStyle": {
                                      "fontSize": {
                                        "magnitude": 11,
                                        "unit": "PT"
                                      }
                                    }
                                  }
                                },
                                {
                                  "startIndex": 26654,
                                  "endIndex": 26680,
                                  "textRun": {
                                    "content": "instructions for decoction",
                                    "textStyle": {
                                      "underline": true,
                                      "foregroundColor": {
                                        "color": {
                                          "rgbColor": {
                                            "red": 0.06666667,
                                            "green": 0.33333334,
                                            "blue": 0.8
                                          }
                                        }
                                      },
                                      "fontSize": {
                                        "magnitude": 11,
                                        "unit": "PT"
                                      },
                                      "link": {
                                        "url": "https://www.cmchk.org.hk/pcm/pdf/guide_retail_e.pdf"
                                      }
                                    }
                                  }
                                },
                                {
                                  "startIndex": 26680,
                                  "endIndex": 26955,
                                  "textRun": {
                                    "content": " (simmering herbs in water). Staff described a need for combination and guidance. Buyers therefore face more decisions and preparation than with preselected soup packs, which helps explain lower demand. The interview did not identify a specific combination or clinical case.\n",
                                    "textStyle": {
                                      "fontSize": {
                                        "magnitude": 11,
                                        "unit": "PT"
                                      }
                                    }
                                  }
                                }
                              ],
