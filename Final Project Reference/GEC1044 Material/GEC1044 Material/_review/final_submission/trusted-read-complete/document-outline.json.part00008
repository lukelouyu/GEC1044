      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": {
        "tableStartIndex": 19978,
        "rowIndex": 4,
        "columnIndex": 3
      },
      "text": "Tonifies Qi; strengthens exterior defence; promotes fluid discharge and tissue repair.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00171",
      "path": "tabs.t.0.body.content[128].table.rows[4].cells[4].content[0]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 20932,
      "endIndex": 21039,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": {
        "tableStartIndex": 19978,
        "rowIndex": 4,
        "columnIndex": 4
      },
      "text": "Fatigue, poor appetite and loose stools in Qi deficiency; spontaneous sweating from weak exterior defence.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00172",
      "path": "tabs.t.0.body.content[128].table.rows[5].cells[0].content[0]",
