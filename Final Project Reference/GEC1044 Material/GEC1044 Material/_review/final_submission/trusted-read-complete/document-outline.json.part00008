      "nestingLevel": null,
      "table": {
        "tableStartIndex": 19978,
        "rowIndex": 4,
        "columnIndex": 2
      },
      "text": "Spleen, Lung",
      "protectedControls": []
    },
    {
      "paragraphId": "P00170",
      "path": "tabs.t.0.body.content[128].table.rows[4].cells[3].content[0]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 20844,
