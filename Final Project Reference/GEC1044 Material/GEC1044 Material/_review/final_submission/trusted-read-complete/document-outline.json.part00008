      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": {
        "tableStartIndex": 19978,
        "rowIndex": 5,
        "columnIndex": 1
      },
      "text": "Sweet; slightly cold",
      "protectedControls": []
    },
    {
      "paragraphId": "P00176",
      "path": "tabs.t.0.body.content[128].table.rows[5].cells[2].content[0]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
