        "tableStartIndex": 19978,
        "rowIndex": 5,
        "columnIndex": 0
      },
      "text": "[Fragrant Solomon’s seal (rhizome)](https://herbaltcm.sn.polyu.edu.hk/herbal/fragrant-solomonseal-rhizome)",
      "protectedControls": []
    },
    {
      "paragraphId": "P00175",
      "path": "tabs.t.0.body.content[128].table.rows[5].cells[1].content[0]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
