      "table": {
        "tableStartIndex": 19978,
        "rowIndex": 6,
        "columnIndex": 0
      },
      "text": "[Chinese yam (rhizome)](https://herbaltcm.sn.polyu.edu.hk/herbal/common-yam-rhizome)",
      "protectedControls": []
    },
