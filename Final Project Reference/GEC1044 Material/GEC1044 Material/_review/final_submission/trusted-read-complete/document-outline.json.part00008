      "listId": null,
      "nestingLevel": null,
      "table": {
        "tableStartIndex": 19978,
        "rowIndex": 5,
        "columnIndex": 2
      },
      "text": "Lung, Stomach",
      "protectedControls": []
    },
    {
      "paragraphId": "P00177",
      "path": "tabs.t.0.body.content[128].table.rows[5].cells[3].content[0]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 21125,
      "endIndex": 21196,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": {
        "tableStartIndex": 19978,
        "rowIndex": 5,
        "columnIndex": 3
      },
      "text": "Nourishes Yin; moistens dryness; generates fluids and relieves thirst.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00178",
      "path": "tabs.t.0.body.content[128].table.rows[5].cells[4].content[0]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 21197,
      "endIndex": 21262,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": {
        "tableStartIndex": 19978,
        "rowIndex": 5,
        "columnIndex": 4
      },
      "text": "Dry cough, dry throat and thirst in Lung–Stomach Yin deficiency.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00179",
      "path": "tabs.t.0.body.content[128].table.rows[6].cells[0].content[0]",
