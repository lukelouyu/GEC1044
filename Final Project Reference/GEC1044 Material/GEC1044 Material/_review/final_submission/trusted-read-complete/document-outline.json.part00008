      "table": {
        "tableStartIndex": 19978,
        "rowIndex": 6,
        "columnIndex": 1
      },
      "text": "Sweet; neutral",
      "protectedControls": []
    },
    {
      "paragraphId": "P00183",
      "path": "tabs.t.0.body.content[128].table.rows[6].cells[2].content[0]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 21332,
      "endIndex": 21353,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": {
        "tableStartIndex": 19978,
        "rowIndex": 6,
        "columnIndex": 2
      },
      "text": "Spleen, Lung, Kidney",
      "protectedControls": []
    },
    {
      "paragraphId": "P00184",
      "path": "tabs.t.0.body.content[128].table.rows[6].cells[3].content[0]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 21354,
      "endIndex": 21439,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": {
        "tableStartIndex": 19978,
        "rowIndex": 6,
        "columnIndex": 3
      },
      "text": "Supports Spleen and Stomach; generates fluids and benefits Lung; strengthens Kidney.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00185",
      "path": "tabs.t.0.body.content[128].table.rows[6].cells[4].content[0]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 21440,
      "endIndex": 21576,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": {
        "tableStartIndex": 19978,
        "rowIndex": 6,
        "columnIndex": 4
      },
      "text": "Poor appetite and persistent diarrhoea in Spleen deficiency; chronic cough in Lung deficiency; frequent urination in Kidney deficiency.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00186",
      "path": "tabs.t.0.body.content[128].table.rows[7].cells[0].content[0]",
