      "listId": null,
      "nestingLevel": null,
      "table": {
        "tableStartIndex": 23410,
        "rowIndex": 1,
        "columnIndex": 1
      },
      "text": "[Ginseng](https://herbaltcm.sn.polyu.edu.hk/herbal/ginseng): sweet, slightly bitter; neutral. [American ginseng](https://herbaltcm.sn.polyu.edu.hk/herbal/american-ginseng): sweet, slightly bitter; cool.",
      "protectedControls": []
    },
    {
