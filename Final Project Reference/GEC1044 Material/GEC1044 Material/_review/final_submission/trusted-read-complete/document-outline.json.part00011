      "nestingLevel": null,
      "table": {
        "tableStartIndex": 23410,
        "rowIndex": 1,
        "columnIndex": 2
      },
      "text": "[Ginseng](https://herbaltcm.sn.polyu.edu.hk/herbal/ginseng): Heart, Spleen, Lung. [American ginseng](https://herbaltcm.sn.polyu.edu.hk/herbal/american-ginseng): Heart, Lung, Kidney.",
      "protectedControls": []
    },
