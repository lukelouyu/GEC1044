eType": "NORMAL_TEXT",
                  "alignment": "START",
                  "lineSpacing": 115,
                  "direction": "LEFT_TO_RIGHT",
                  "spaceAbove": {
                    "unit": "PT"
                  },
                  "spaceBelow": {
                    "magnitude": 7,
                    "unit": "PT"
                  },
                  "avoidWidowAndOrphan": true
                }
              }
            },
            {
              "startIndex": 2765,
              "endIndex": 3233,
              "paragraph": {
                "elements": [
                  {
                    "startIndex": 2765,
                    "endIndex": 3233,
                    "textRun": {
                      "content": "Hougang Central had about 4,620 residents in June 2025, with roughly 1,070 aged 65 or above (23%) (DOS, 2025). Chua et al.’s (2025) 647 Hougang respondents averaged 69 years of age and 22 years’ residence. The area also has Teochew heritage around Tou Mu Kung, fishing, farming and rubber-growing (National Heritage Board [NHB], n.d.). This established residential setting helps explain the reported clientele, but may not represent outlets in younger neighbourhoods.\n",
                      "textStyle": {
                        "fontSize": {
                          "magnitude": 11,
                          "unit": "PT"
                        }
                      }
                    }
                  }
                ],
                "paragraphStyle": {
                  "namedStyleType": "NORMAL_TEXT",
                  "alignment": "START",
                  "lineSpacing": 115,
                  "direction": "LEFT_TO_RIGHT",
                  "spaceAbove": {
                    "unit": "PT"
