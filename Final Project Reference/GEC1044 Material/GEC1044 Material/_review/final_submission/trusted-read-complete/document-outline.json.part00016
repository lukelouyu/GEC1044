      "nestingLevel": null,
      "table": {
        "tableStartIndex": 30014,
        "rowIndex": 2,
        "columnIndex": 1
      },
      "text": "Huoxiang Zhengqi type remedies",
      "protectedControls": []
    },
    {
      "paragraphId": "P00349",
      "path": "tabs.t.0.body.content[145].table.rows[2].cells[2].content[0]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 30579,
      "endIndex": 30988,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": {
        "tableStartIndex": 30014,
        "rowIndex": 2,
        "columnIndex": 2
      },
      "text": "Mei Hua Huoxiang Zhengqi contains patchouli, perilla leaf, angelica dahurica root, atractylodes, tangerine peel, pinellia, magnolia bark, poria, platycodon, licorice, areca peel, jujube and ginger. [Science Arts](https://www.sciencearts.com/shop/condensed-huoxiang-zhengqi-wan-200-s) describes dampness-related presentations involving vomiting, diarrhoea, abdominal fullness and body heaviness. The reference context distinguishes a symptom cluster from diarrhoea considered alone.",
      "protectedControls": []
    },
