        "tableStartIndex": 30014,
        "rowIndex": 1,
        "columnIndex": 1
      },
      "text": "Yin Qiao type remedies",
      "protectedControls": []
    },
    {
      "paragraphId": "P00345",
      "path": "tabs.t.0.body.content[145].table.rows[1].cells[2].content[0]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 30160,
      "endIndex": 30532,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": {
        "tableStartIndex": 30014,
        "rowIndex": 1,
        "columnIndex": 2
      },
      "text": "Mei Hua Yin Qiao contains honeysuckle, forsythia, platycodon, mint, lophatherum, licorice, schizonepeta, prepared soybean, burdock fruit and reed rhizome. [Science Arts](https://www.sciencearts.com/shop/yin-qiao-capsules-30-s) describes a heat-related presentation involving fever, sore throat and thirst, with tongue and pulse features also listed. These are reference descriptors for comparison with the broad complaint “colds”.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00346",
      "path": "tabs.t.0.body.content[145].table.rows[2].cells[0].content[0]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 30534,
      "endIndex": 30544,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": {
        "tableStartIndex": 30014,
        "rowIndex": 2,
        "columnIndex": 0
      },
      "text": "Diarrhoea",
      "protectedControls": []
    },
    {
      "paragraphId": "P00347",
      "path": "tabs.t.0.body.content[145].table.rows[2].cells[1].content[0]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
