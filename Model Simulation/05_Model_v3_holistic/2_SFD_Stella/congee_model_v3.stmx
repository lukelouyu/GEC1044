<?xml version="1.0" encoding="utf-8"?>
<xmile version="1.0" xmlns="http://docs.oasis-open.org/xmile/ns/XMILE/v1.0" xmlns:isee="http://iseesystems.com/XMILE">
	<header>
		<smile version="1.0" namespace="std, isee"/>
		<name>congee_model_v3</name>
		<uuid>6e4d769a-4cf3-4901-9765-8ca696fc5f2f</uuid>
		<vendor>isee systems, inc.</vendor>
		<product version="3.0" lang="en">Stella Architect</product>
	</header>
	<sim_specs method="Euler" time_units="Weeks">
		<start>-8</start>
		<stop>18</stop>
		<dt reciprocal="true">7</dt>
	</sim_specs>
	<model>
		<variables>
			<stock name="Perceived Stress">
				<doc>Index 0-1. Starts the pre-semester holiday (week -8) at this value.</doc>
				<eqn>0.35</eqn>
				<inflow>Change_in_Stress</inflow>
			</stock>
			<stock name="Rumination">
				<doc>Index 0-1. Starts the pre-semester holiday (week -8) at this value.</doc>
				<eqn>0.3</eqn>
				<inflow>Change_in_Rumination</inflow>
			</stock>
			<stock name="Mindfulness">
				<doc>Index 0-1. Starts the pre-semester holiday (week -8) at this value.</doc>
				<eqn>0.2</eqn>
				<inflow>Change_in_Mindfulness</inflow>
			</stock>
			<stock name="Liver Qi Stagnation">
				<doc>Index 0-1. Starts the pre-semester holiday (week -8) at this value.</doc>
				<eqn>0.35</eqn>
				<inflow>Qi_Stagnation_Buildup</inflow>
				<outflow>Liver_Qi_Soothing</outflow>
			</stock>
			<stock name="Spleen Function">
				<doc>Index 0-1. Starts the pre-semester holiday (week -8) at this value.</doc>
				<eqn>0.6</eqn>
				<inflow>Spleen_Nourishment</inflow>
				<outflow>Spleen_Depletion</outflow>
			</stock>
			<stock name="Calm Shen">
				<doc>Index 0-1. Starts the pre-semester holiday (week -8) at this value.</doc>
				<eqn>0.6</eqn>
				<inflow>Shen_Settling</inflow>
				<outflow>Shen_Disturbance</outflow>
			</stock>
			<stock name="Sleep Quality">
				<doc>Index 0-1. Starts the pre-semester holiday (week -8) at this value.</doc>
				<eqn>0.6</eqn>
				<inflow>Change_in_Sleep</inflow>
			</stock>
			<stock name="Fatigue">
				<doc>Index 0-1. Starts the pre-semester holiday (week -8) at this value.</doc>
				<eqn>0.35</eqn>
				<inflow>Fatigue_Accumulation</inflow>
				<outflow>Fatigue_Recovery</outflow>
			</stock>
			<stock name="Unhealthy Habits">
				<doc>Index 0-1. Starts the pre-semester holiday (week -8) at this value.</doc>
				<eqn>0.25</eqn>
				<inflow>Habit_Uptake</inflow>
				<outflow>Habit_Quitting</outflow>
			</stock>
			<stock name="Congee Habit">
				<doc>Index 0-1. Starts the pre-semester holiday (week -8) at this value.</doc>
				<eqn>0</eqn>
				<inflow>Congee_Habit_Change</inflow>
			</stock>
			<stock name="Self Care Engagement">
				<doc>Index 0-1. Starts the pre-semester holiday (week -8) at this value.</doc>
				<eqn>0.5</eqn>
				<inflow>Change_in_Self_Care</inflow>
			</stock>
			<stock name="Sense of Control">
				<doc>Index 0-1. Starts the pre-semester holiday (week -8) at this value.</doc>
				<eqn>0.4</eqn>
				<inflow>Change_in_Control</inflow>
			</stock>
			<flow name="Change in Stress">
				<eqn>(MIN(MAX(0.28 - 0 + 0.35 * Study_Load + 0.35 * (Felt_Fatigue - 0.4) + 0.3 * (0.45 - Sense_of_Control) + 0.6 * Time_Squeeze, 0), 1) - Perceived_Stress) / 0.4</eqn>
			</flow>
			<flow name="Change in Rumination">
				<eqn>(MIN(MAX(0.05 + 0.7 * Perceived_Stress + 0.3 * (0.6 - Sleep_Quality) - 0.3 * (Mindfulness - 0.2) + 0.3 * (Heart_Blood_Malnourishment - 0.35), 0), 1) - Rumination) / 0.3</eqn>
			</flow>
			<flow name="Change in Mindfulness">
				<eqn>(0.2 + 0.6 * 0.25 * Mindful_Cooking - Mindfulness) / 1</eqn>
			</flow>
			<flow name="Qi Stagnation Buildup">
				<eqn>(1 - Liver_Qi_Stagnation) * (0.6 * Perceived_Stress + 0.6 * Rumination) * 1</eqn>
				<non_negative/>
			</flow>
			<flow name="Liver Qi Soothing">
				<eqn>Liver_Qi_Stagnation * (0.6 + 0.8 * TCM_Practice) * 1</eqn>
				<non_negative/>
			</flow>
			<flow name="Spleen Nourishment">
				<eqn>(1 - Spleen_Function) * (0.22 + 0.3 * Spleen_Strengthening_Effect) * 1</eqn>
				<non_negative/>
			</flow>
			<flow name="Spleen Depletion">
				<eqn>Spleen_Function * (0.02 + 0.1 * Rumination + 0.1 * Liver_Qi_Stagnation + 0.15 * Unhealthy_Habits + 0.05 * Circadian_Disruption) * 1</eqn>
				<non_negative/>
			</flow>
			<flow name="Shen Settling">
				<eqn>(1 - Calm_Shen) * (0.36 + 0.35 * Shen_Calming_Effect) * 1</eqn>
				<non_negative/>
			</flow>
			<flow name="Shen Disturbance">
				<eqn>Calm_Shen * (0.015 + 0.4 * Rumination + 0.15 * Unhealthy_Habits + 0.1 * Circadian_Disruption) * 1</eqn>
				<non_negative/>
			</flow>
			<flow name="Change in Sleep">
				<eqn>(MIN(MAX(0.15 + 0.75 * Calm_Shen - 0.3 * (Unhealthy_Habits - 0.2) - 0.25 * (Yin_Deficiency_Factor * Circadian_Disruption - 0.45) - 0.3 * (Yin_Deficiency_Factor * Heart_Blood_Malnourishment - 0.35), 0), 1) - Sleep_Quality) / 0.7</eqn>
			</flow>
			<flow name="Fatigue Accumulation">
				<eqn>(1 - Fatigue) * (1.43 * Yang_Deficiency_Factor * Study_Load + 0.004 * Cooking_Workload)</eqn>
				<non_negative/>
			</flow>
			<flow name="Fatigue Recovery">
				<eqn>Fatigue * (0.23 + 0.5 * Sleep_Quality + 0.5 * Qi_Blood_Generation + 0.25 * Recovery_Break + 0.5 * Body_Awareness)</eqn>
				<non_negative/>
			</flow>
			<flow name="Habit Uptake">
				<eqn>(1 - Unhealthy_Habits) * Lifestyle_Propensity * (0.5 * Felt_Fatigue + 0.3 * Perceived_Stress + 0.4 * Unhealthy_Habits) / 1.5</eqn>
				<non_negative/>
			</flow>
			<flow name="Habit Quitting">
				<eqn>Unhealthy_Habits * (0.6 + 0.8 * Self_Care_Engagement + 0.3 * Servings_Eaten / 7) / 1.5</eqn>
				<non_negative/>
			</flow>
			<flow name="Congee Habit Change">
				<eqn>(Adherence * MIN(Planned_Servings, 1) - Congee_Habit) / 3</eqn>
			</flow>
			<flow name="Change in Self Care">
				<eqn>(MIN(MAX(0.55 + 0.4 * (Physical_Wellbeing / 100 - 0.6) + 0.45 * (Mental_Wellbeing / 100 - 0.55) - 0.35 * (Unhealthy_Habits - 0.3), 0), 1) - Self_Care_Engagement) / 0.7</eqn>
			</flow>
			<flow name="Change in Control">
				<eqn>(0.2 + 0.75 * Behavioural_Activation - Sense_of_Control) / 2</eqn>
			</flow>
			<aux name="Scenario">
				<doc>1 = no congee + bad habits; 2 = no congee + healthy lifestyle; 3 = congee once a week; 4 = congee every day; 0 = typical NUS student (calibration reference)</doc>
				<eqn>4</eqn>
			</aux>
			<aux name="Constitution">
				<doc>Individual constitution (ti zhi): 0 = balanced, 1 = Yin deficiency, 2 = Yang deficiency</doc>
				<eqn>0</eqn>
			</aux>
			<aux name="Yin Deficiency Factor">
				<doc>Yin deficiency: the same late nights and Heart-blood deficiency disturb sleep 1.5x more</doc>
				<eqn>Constitution</eqn>
				<gf type="discrete">
					<xscale min="0" max="2"/>
					<yscale min="0" max="2"/>
					<ypts>1.0000,1.5000,1.0000</ypts>
				</gf>
			</aux>
			<aux name="Yang Deficiency Factor">
				<doc>Yang deficiency: the same study load builds fatigue 1.5x faster</doc>
				<eqn>Constitution</eqn>
				<gf type="discrete">
					<xscale min="0" max="2"/>
					<yscale min="0" max="2"/>
					<ypts>1.0000,1.0000,1.5000</ypts>
				</gf>
			</aux>
			<aux name="Academic Demands">
				<doc>Study hours / waking hours by semester week (NUS Registrar: 20 units = 50 h/week)</doc>
				<eqn>TIME</eqn>
				<gf type="discrete">
					<xscale min="-8.001" max="16.999"/>
					<yscale min="0" max="1"/>
					<ypts>0.1500,0.1500,0.1500,0.1500,0.1500,0.1500,0.1500,0.1500,0.2114,0.2325,0.2607,0.2818,0.2818,0.2818,0.1409,0.5637,0.5637,0.3523,0.5637,0.5989,0.6200,0.5989,0.3875,0.6694,0.6694,0.1057</ypts>
				</gf>
			</aux>
			<aux name="Course Load">
				<doc>Units taken / 20 units</doc>
				<eqn>1</eqn>
			</aux>
			<aux name="Study Load">
				<eqn>Academic_Demands * Course_Load</eqn>
			</aux>
			<aux name="Free Hours">
				<doc>Waking hours left after study (hours/week)</doc>
				<eqn>120.12 * MAX(1 - Study_Load, 0.2)</eqn>
			</aux>
			<aux name="Circadian Disruption">
				<doc>Tian Ren He Yi: share of late or all-night study nights; rises with study load</doc>
				<eqn>MIN(MAX(1.1 * Study_Load, 0), 1)</eqn>
			</aux>
			<aux name="Congee Plan">
				<doc>Servings per week planned in each scenario: 3 -&gt; 2 (one batch a week); 4 -&gt; 7 (one bowl a day)</doc>
				<eqn>Scenario</eqn>
				<gf type="discrete">
					<xscale min="0" max="4"/>
					<yscale min="0" max="7"/>
					<ypts>0.0000,0.0000,0.0000,2.0000,7.0000</ypts>
				</gf>
			</aux>
			<aux name="Planned Servings">
				<doc>No congee during the pre-semester holiday; the plan starts in week 1</doc>
				<eqn>IF TIME &gt; -0.001 THEN Congee_Plan ELSE 0</eqn>
			</aux>
			<aux name="Lifestyle Propensity">
				<doc>Tendency to cope with caffeine, cigarettes, alcohol and junk food</doc>
				<eqn>Scenario</eqn>
				<gf type="discrete">
					<xscale min="0" max="4"/>
					<yscale min="0" max="10"/>
					<ypts>1.0000,9.5000,0.3500,0.3500,0.3500</ypts>
				</gf>
			</aux>
			<aux name="Adherence">
				<doc>Share of planned servings actually cooked and eaten; daily plans are dropped more under stress</doc>
				<eqn>MIN(MAX(0.5 + 0.3 * (Self_Care_Engagement - 0.5) + 0.35 * Congee_Habit - 0.25 * (Planned_Servings / 7) * Perceived_Stress, 0), 1)</eqn>
			</aux>
			<aux name="Servings Eaten">
				<eqn>Planned_Servings * Adherence</eqn>
			</aux>
			<aux name="Batches Cooked">
				<eqn>Servings_Eaten / 2</eqn>
			</aux>
			<aux name="Cooking Workload">
				<doc>Hours per week spent preparing congee</doc>
				<eqn>Batches_Cooked * 1.25</eqn>
			</aux>
			<aux name="Recovery Break">
				<doc>Detachment from study while cooking (saturating)</doc>
				<eqn>Cooking_Workload / (Cooking_Workload + 2.5)</eqn>
			</aux>
			<aux name="Mindful Cooking">
				<doc>Present-moment attention practised while washing, cutting and simmering</doc>
				<eqn>Cooking_Workload / (Cooking_Workload + 2.5)</eqn>
			</aux>
			<aux name="Time Squeeze">
				<doc>Share of free time used by cooking</doc>
				<eqn>Cooking_Workload / Free_Hours</eqn>
			</aux>
			<aux name="Spleen Strengthening Effect">
				<doc>Chinese yam + red date (jian pi yi qi), saturating dose-response</doc>
				<eqn>0.5 * Servings_Eaten / (Servings_Eaten + 3.5)</eqn>
			</aux>
			<aux name="Shen Calming Effect">
				<doc>Lotus seed + red date (yang xin an shen), saturating dose-response</doc>
				<eqn>0.5 * Servings_Eaten / (Servings_Eaten + 3.5)</eqn>
			</aux>
			<aux name="TCM Practice">
				<doc>TCM non-pharmacological interventions: acupoint massage, Baduanjin / gentle exercise</doc>
				<eqn>MIN(MAX(0.3 + 0.6 * (Self_Care_Engagement - 0.5), 0), 1)</eqn>
			</aux>
			<aux name="Qi Blood Generation">
				<doc>Qi and blood made by the Spleen (qi xue sheng hua zhi yuan); movement adds</doc>
				<eqn>MIN(MAX(0.1 + 0.8 * Spleen_Function + 0.3 * (TCM_Practice - 0.3), 0), 1)</eqn>
			</aux>
			<aux name="Heart Blood Malnourishment">
				<doc>Heart blood / shen malnourishment: rises when Spleen and qi-blood are weak</doc>
				<eqn>MIN(MAX(0.645 - 0.25 * Spleen_Function - 0.25 * Qi_Blood_Generation, 0), 1)</eqn>
			</aux>
			<aux name="Behavioural Activation">
				<eqn>0.25 + 0.6 * 0.25 * Batches_Cooked / (Batches_Cooked + 1)</eqn>
			</aux>
			<aux name="Felt Fatigue">
				<doc>Fatigue as felt; caffeine and nicotine mask part of it</doc>
				<eqn>Fatigue * (1 - 0.3 * Unhealthy_Habits)</eqn>
			</aux>
			<aux name="Body Awareness">
				<doc>Zhi Wei Bing: noticing early tiredness (needs mindfulness and a felt signal) -&gt; early rest</doc>
				<eqn>MIN(MAX(2 * Mindfulness * Felt_Fatigue, 0), 1)</eqn>
			</aux>
			<aux name="Physical Wellbeing">
				<doc>0-100; uses true (unmasked) fatigue</doc>
				<eqn>100 * (0.35 * Qi_Blood_Generation + 0.25 * Sleep_Quality + 0.40 * (1 - Fatigue))</eqn>
			</aux>
			<aux name="Mental Wellbeing">
				<doc>0-100, WHO-5-like scale</doc>
				<eqn>100 * (0.22 * (1 - Perceived_Stress) + 0.22 * (1 - Rumination) + 0.14 * Sense_of_Control + 0.18 * Calm_Shen + 0.12 * Spleen_Function + 0.12 * Mindfulness)</eqn>
			</aux>
		</variables>
		<views>
			<view isee:show_pages="false" page_width="1840" page_height="1310">
